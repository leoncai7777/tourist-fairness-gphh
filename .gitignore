data/verona/veronacard_2022_original.csv
data/verona/data_2023.csv

# Toronto Flickr data: no licence in the source repo, contains Flickr user IDs, keep local only
data/toronto/

# TOPTW benchmark instances: downloaded from the KU Leuven orienteering page, no stated licence, keep local only
data/toptw/

# Pilot runs of the search: checkpoints and per-run outputs stay local; only each phase's record.md is kept
outputs/search/pilot/*/*/

# Formal runs: checkpoints and per-run outputs stay local (large); the records written from them are kept
outputs/search/formal/

# Step 6 test evaluation: blocks, rule list and pass record stay local (large; per-visitor rows); records written from them are kept
outputs/test/
# Tables from itinerary-drl: the data's licence is not stated, keep local only (download as in data/README.md)
data/verona/poi_it_complete.csv
data/verona/poi_time_travel.csv
data/verona/log_crowd.csv
data/verona/poi_popularity_train.csv

